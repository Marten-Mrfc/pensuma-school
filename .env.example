# Pensuma environment. Copy to .env for development; set the same variables
# in Dokploy (Environment) for production. Validated at startup in src/env.ts.

# PostgreSQL connection string.
DATABASE_URL=postgresql://pensuma:pensuma@localhost:5432/pensuma

# Signs sessions and encrypts stored student PINs. Production: a random value
# of at least 32 characters, generate with `openssl rand -base64 32`.
# Changing it signs everyone out AND makes stored PINs unreadable (see README).
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32

# docker-compose.yml only: password of the bundled Postgres. Use hex (no
# characters that need escaping in DATABASE_URL): `openssl rand -hex 24`.
# POSTGRES_PASSWORD=

# Public URL of the app (cookies, origin checks). Production: https:// required.
BETTER_AUTH_URL=http://localhost:3000

# Only for a pilot on a school LAN without TLS: allow an http:// BETTER_AUTH_URL
# in production. Never on the internet.
# ALLOW_INSECURE_HTTP=false

# Reverse proxies in front of the app (comma-separated IPs/CIDRs), so the real
# client IP is used for rate limits and the audit log. For Dokploy/Traefik use
# the subnet of `docker network inspect dokploy-network` (IPAM → Subnet).
# TRUSTED_PROXIES=10.0.1.0/24

# Unlocks /setup (creating the first teacher) in production. At least 24
# characters, generate with `openssl rand -base64 32`. Remove it after setup.
# SETUP_TOKEN=

# Failed sign-ins from one IP address within 10 minutes before that address is
# paused for 10 minutes (a whole school often shares one IP).
# LOGIN_IP_MAX_FAILURES=100

# Integration tests only: disables the tRPC rate limiter (ignored unless
# NODE_ENV=test, refused in production).
# RATE_LIMIT_DISABLED=1

# Automatic data retention (privacy): the server runs the clean-up job every
# RETENTION_INTERVAL_HOURS hours (production only; false switches it off).
# RETENTION_SCHEDULER=true
# RETENTION_INTERVAL_HOURS=6

# Production applies pending database migrations at startup (false: skip).
# RUN_MIGRATIONS=true

# Disable Next.js telemetry (also set in the Docker image).
NEXT_TELEMETRY_DISABLED=1

# Optional: server-side Python grader tuning (defaults shown).
# GRADER_POOL_SIZE=2            # warm sandboxes kept ready
# GRADER_MAX_CONCURRENCY=4      # parallel grading jobs; more are queued
# GRADER_MEMORY_LIMIT_MB=768    # kill a sandbox above this RSS
# GRADER_WASM_MEMORY_MB=384     # Python memory cap (MemoryError above)
# GRADER_JOB_TIMEOUT_MS=120000  # budget per grading job
# GRADER_QUEUE_TIMEOUT_MS=120000
# GRADER_MAX_OUTPUT=65536       # output cap per run (bytes)
# GRADER_SNAPSHOT=1             # 0 disables the fast-start snapshot (needs writable /tmp)

# Optional: demo data and the first teacher account created by `bun run db:seed`.
# Never seed demo data in production.
# SEED_DEMO=false
# SEED_ADMIN_EMAIL=docent@school.nl
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Docent
